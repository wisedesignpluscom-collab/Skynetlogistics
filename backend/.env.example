ENV=development

# Postgres
DATABASE_URL=postgresql+asyncpg://fleet:fleet_dev_pw@localhost:5432/fleet_db

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# Seed (usado por `python -m app.seed`)
SEED_SUPERADMIN_EMAIL=admin@fleetops.dev
SEED_SUPERADMIN_PASSWORD=change-me-please
